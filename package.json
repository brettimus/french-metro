{
  "name": "@french-metro/root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "start": "bun run --cwd apps/web start",
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "deploy": "bash apps/web/ops/deploy.sh french-metro.exe.xyz"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  }
}
